 "command": "python3 -m pip install --quiet pillow >/dev/null 2>&1 || true\ncat > /tmp/look.py <<'EOF'\nimport urllib.request, io, colorsys, sys\nfrom PIL import Image\nbase = sys.argv[1]\nnames = sys.argv[2:]\nfor n in names:\n    data = urllib.request.urlopen(base + n).read()\n    im = Image.open(io.BytesIO(data)).convert('RGB')\n    W, H = im.size\n    cols = 150\n    rows = max(10, int(H / W * cols * 0.5))\n    px = im.load()\n    print('==', n, W, 'x', H)\n    lil = []\n    for y in range(0, H, 2):\n        for x in range(0, W, 2):\n            R, G, B = px[x, y]\n            h, s, v = colorsys.rgb_to_hsv(R / 255, G / 255, B / 255)\n            if 0.66 <= h <= 0.81 and s > 0.12 and v > 0.15:\n                lil.append((x, y, s * v))\n    strong = [p for p in lil if p[2] > 0.3]\n    if strong:\n        xs = [p[0] for p in strong]; ys = [p[1] for p in strong]\n        top = max(strong, key=lambda p: p[2])\n        print('lilac px:', len(lil), 'strong:', len(strong), 'bbox strong x', min(xs), max(xs), 'y', min(ys), max(ys), 'brightest', top)\n    else:\n        print('lilac px:', len(lil), 'strong: 0')\n    for r in range(rows):\n        line = ''\n        for c in range(cols):\n            x0 = int(c * W / cols); x1 = max(x0 + 1, int((c + 1) * W / cols)); y0 = int(r * H / rows); y1 = max(y0 + 1, int((r + 1) * H / rows))\n            best = 0; lum = 0; cnt = 0\n            for y in range(y0, y1, max(1, (y1 - y0) // 4)):\n                for x in range(x0, x1, max(1, (x1 - x0) // 3)):\n                    R, G, B = px[x, y]\n                    h, s, v = colorsys.rgb_to_hsv(R / 255, G / 255, B / 255)\n                    lum += v; cnt += 1\n                    if 0.66 <= h <= 0.81 and s > 0.12 and v > 0.12:\n                        best = max(best, s * v)\n            l = lum / cnt\n            if best > 0.45: ch = '#'\n            elif best > 0.3: ch = '*'\n            elif best > 0.16: ch = '+'\n            elif best > 0.06: ch = ':'\n            elif best > 0.02: ch = '.'\n            else: ch = ' ' if l < 0.1 else ('-' if l < 0.55 else ('=' if l < 0.93 else ' '))\n            line += ch\n        print('|' + line + '|')\nEOF\npython3 /tmp/look.py https://raw.githubusercontent.com/miguelcoxcaballero/inhouselearn/screenshots/shot-20261101-180833-t0zc/ 1-oscuro-0-3-s.png 2-oscuro-0-65-s.png 3-oscuro-1-0-s.png 4-oscuro-fijo.png 5-claro-0-65-s.png 6-movil-oscuro-0-5-s.png",
