 "command": "pip install pillow -q 2>&1 | tail -1\ncat > /tmp/heat2.py <<'PY'\nimport urllib.request, io\nfrom PIL import Image\nbase = 'https://raw.githubusercontent.com/miguelcoxcaballero/inhouselearn/screenshots/shot-20261101-191305-48tn/'\nfiles = ['1-0-3-s.png', '2-0-65-s.png', '3-1-0-s.png', '4-1-4-s.png', '5-1-9-s.png', '6-fijo.png']\nCH = ' .:-=+*#%@'\ndef load(f): return Image.open(io.BytesIO(urllib.request.urlopen(base + f).read())).convert('RGB')\nfixed = load(files[-1]); W, H = fixed.size; fpx = fixed.load()\n# composer top border = row (in lower half) with the most violet pixels in the fixed frame\ndef violet(p): return p[2] - p[1]\nrows = {y: sum(1 for x in range(0, W, 2) if violet(fpx[x, y]) > 14 and fpx[x, y][2] > 40) for y in range(int(H * 0.5), H)}\ntop = max(rows, key=rows.get)\n# horizontal extent of that line\nxs = [x for x in range(W) if violet(fpx[x, top]) > 14 and fpx[x, top][2] > 40]\nx0, x1 = min(xs), max(xs); cx = (x0 + x1) // 2\nprint('composer top border y=%d x=%d..%d (w=%d)' % (top, x0, x1, x1 - x0))\nfor f in files:\n    im = load(f); px = im.load()\n    print('=====', f)\n    # profile above the top border at the centre and 1/4 of the width\n    for label, x in (('centre', cx), ('x@25%', x0 + (x1 - x0) // 4)):\n        prof = [max(0, violet(px[x, y])) for y in range(top - 96, top - 2, 8)]\n        print(' %-7s above top edge (every 8px, far→near):' % label, prof)\n    ys0, ys1 = max(0, top - 80), H\n    cols, nrows = 100, 24\n    cw, rh = (x1 - x0 + 160) / cols, (ys1 - ys0) / nrows\n    for r in range(nrows):\n        line = ''\n        for c in range(cols):\n            best = 0\n            for yy in range(int(ys0 + r * rh), max(int(ys0 + (r + 1) * rh), int(ys0 + r * rh) + 1)):\n                for xx in range(int(x0 - 80 + c * cw), max(int(x0 - 80 + (c + 1) * cw), int(x0 - 80 + c * cw) + 1), 2):\n                    if 0 <= xx < W: best = max(best, violet(px[xx, yy]))\n            line += CH[max(0, min(9, int(best / 14)))]\n        print(line)\nPY\npython3 /tmp/heat2.py",
