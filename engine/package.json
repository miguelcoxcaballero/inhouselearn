{
  "name": "inhouse-learn-engine",
  "private": true,
  "type": "module",
  "description": "Motor de chat de inhouse learn sobre pi (pi-ai + pi-agent-core), empaquetado para el navegador.",
  "scripts": {
    "build": "esbuild src/index.js --bundle --format=iife --global-name=InhousePi --platform=browser --target=es2020 --minify --legal-comments=eof --outfile=../vendor/pi-engine.js --metafile=meta.json"
  },
  "dependencies": {
    "@earendil-works/pi-agent-core": "1.3.0",
    "@earendil-works/pi-ai": "1.3.0",
    "jszip": "3.10.1"
  },
  "devDependencies": {
    "esbuild": "0.25.10"
  }
}
