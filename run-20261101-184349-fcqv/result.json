 "command": "pip install pillow -q 2>&1 | tail -1\ncat > /tmp/heat.py <<'PY'\nimport urllib.request, io\nfrom PIL import Image\nbase = 'https://raw.githubusercontent.com/miguelcoxcaballero/inhouselearn/screenshots/shot-20261101-184055-dtsy/'\nfiles = ['1-antes-0-25-s.png', '2-antes-0-8-s.png', '3-antes-1-3-s.png', '4-antes-fijo.png']\nCH = ' .:-=+*#%@'\nfor f in files:\n    im = Image.open(io.BytesIO(urllib.request.urlopen(base + f).read())).convert('RGB')\n    W, H = im.size\n    px = im.load()\n    pts = [(x, y) for y in range(int(H * 0.45), H) for x in range(W) if px[x, y][2] - px[x, y][1] > 14 and px[x, y][2] > 40]\n    print('=====', f, im.size, 'violet px:', len(pts))\n    if not pts:\n        continue\n    xs = [p[0] for p in pts]; ys = [p[1] for p in pts]\n    x0, x1, y0, y1 = max(0, min(xs) - 10), min(W, max(xs) + 10), max(0, min(ys) - 10), min(H, max(ys) + 10)\n    print('bbox', x0, y0, x1, y1, '| peak (r,g,b):', max((px[x, y] for x, y in pts), key=lambda c: c[2]))\n    cols, rows = 110, 26\n    cw, rh = (x1 - x0) / cols, (y1 - y0) / rows\n    for r in range(rows):\n        line = ''\n        for c in range(cols):\n            best = 0\n            for yy in range(int(y0 + r * rh), max(int(y0 + (r + 1) * rh), int(y0 + r * rh) + 1)):\n                for xx in range(int(x0 + c * cw), max(int(x0 + (c + 1) * cw), int(x0 + c * cw) + 1), 2):\n                    p = px[xx, yy]; best = max(best, p[2] - p[1])\n            line += CH[min(9, int(best / 14))]\n        print(line)\nPY\npython3 /tmp/heat.py",
