{
  "type": "explain",
  "title": "Más ángulo, más sustentación… hasta un límite",
  "question": "Sube el morro. ¿Qué cambia en la fuerza del aire?",
  "scene": {
    "camera": {
      "xmin": 0,
      "xmax": 10,
      "ymin": 0,
      "ymax": 6
    },
    "loop": "static",
    "controls": [
      {
        "kind": "slider",
        "id": "alpha",
        "label": "Ángulo de ataque",
        "min": 0,
        "max": 10,
        "value": 2,
        "step": 1,
        "unit": "°"
      }
    ],
    "vars": {
      "CL": "0.1*alpha",
      "L": "1000*10*CL"
    },
    "layers": [
      {
        "kind": "line",
        "id": "reference",
        "from": [
          1,
          2.9
        ],
        "to": [
          9,
          2.9
        ],
        "color": "#8b9098",
        "dash": "6 6"
      },
      {
        "kind": "body",
        "id": "wing",
        "shape": "airfoil",
        "at": [
          5,
          3
        ],
        "width": 5.7,
        "angle": "-alpha",
        "fill": "#d7e4ee",
        "stroke": "#49708a"
      },
      {
        "kind": "arrow",
        "id": "air",
        "from": [
          0.6,
          1.3
        ],
        "to": [
          3,
          1.3
        ],
        "color": "#3995c9",
        "strokeWidth": 3
      },
      {
        "kind": "label",
        "id": "airlabel",
        "at": [
          1.8,
          0.7
        ],
        "text": "Aire →",
        "size": 18,
        "color": "#3995c9"
      },
      {
        "kind": "arrow",
        "id": "lift",
        "from": [
          4.5,
          3.2
        ],
        "to": [
          4.5,
          "3.2+alpha*0.19"
        ],
        "visible": "alpha>0",
        "color": "#df803b",
        "strokeWidth": 4
      },
      {
        "kind": "label",
        "id": "liftlabel",
        "at": [
          5.7,
          5.3
        ],
        "text": "Sustentación ↑",
        "size": 18,
        "color": "#df803b"
      },
      {
        "kind": "label",
        "id": "winglabel",
        "at": [
          7.8,
          2
        ],
        "text": "Perfil del ala",
        "size": 17
      }
    ],
    "readouts": [
      {
        "label": "Coeficiente C_L",
        "expr": "CL",
        "digits": 2
      },
      {
        "label": "Sustentación",
        "expr": "L",
        "unit": "N",
        "digits": 0
      }
    ]
  },
  "steps": [
    {
      "title": "Observa",
      "body": "El aire llega desde la izquierda. El perfil está ligeramente inclinado. La flecha naranja representa la sustentación.",
      "set": {
        "alpha": 2
      },
      "focus": [
        "wing",
        "air",
        "airlabel",
        "lift",
        "liftlabel"
      ]
    },
    {
      "title": "Cambia",
      "body": "Aumentamos solo el ángulo de ataque. En este modelo, la flecha de sustentación crece. La velocidad y el área siguen iguales.",
      "set": {
        "alpha": 6
      },
      "focus": [
        "wing",
        "lift",
        "liftlabel"
      ],
      "notice": "Misma ala y velocidad; cambia la inclinación."
    },
    {
      "title": "Conecta",
      "body": "Al crecer el ángulo, crece el coeficiente de sustentación. Con presión dinámica y área constantes, aumenta la fuerza.",
      "set": {
        "alpha": 6
      },
      "focus": [
        "lift",
        "liftlabel",
        "wing"
      ],
      "equation": "\\(L=qS C_L\\)",
      "notice": "Duplica el ángulo con el deslizador y compara la fuerza."
    }
  ],
  "takeaway": "Dentro de este modelo lineal, el ángulo controla el coeficiente y este determina la fuerza. Fuera del rango, cerca de la pérdida, esta relación deja de servir.",
  "assumption": "Perfil simétrico idealizado, flujo adherido, q = 1000 Pa y S = 10 m² constantes. C_L = 0,1 α con α en grados. Flecha esquemática; no es una simulación de flujo."
}
