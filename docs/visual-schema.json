{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "https://miguelcoxcaballero.github.io/inhouselearn/docs/visual-schema.json",
 "title": "Inhouse Learn ```visual blocks",
 "description": "The model writes ```visual followed by one JSON object. The ten static types (plot, formula, chart, flashcards, steps, timeline, compare, check, cards) are described in VISUALS_PROMPT (visuals.js) and unchanged; this schema adds scene, causal explain walkthroughs and sandbox. Runtime checks: validateScene/validateSandbox in scene.js and validateExplain in explain.js. Exposed variables: button → <id>, <id>_count; handle → <id>_x, <id>_y; points → <id>_n, <id>_mx, <id>_my; draw → <id>_n, <id>_len; pendulum → <id>_angle (deg), <id>_omega, <id>_x, <id>_y.",
 "oneOf": [
  {
   "$ref": "#/$defs/explain"
  },
  {
   "$ref": "#/$defs/scene"
  },
  {
   "$ref": "#/$defs/sandbox"
  },
  {
   "type": "object",
   "properties": {
    "type": {
     "enum": [
      "plot",
      "formula",
      "chart",
      "flashcards",
      "steps",
      "timeline",
      "compare",
      "check",
      "cards",
      "match",
      "order",
      "categorize",
      "fill",
      "estimate",
      "truefalse"
     ]
    }
   },
   "required": [
    "type"
   ]
  }
 ],
 "$defs": {
  "id": {
   "type": "string",
   "pattern": "^[A-Za-z_][A-Za-z_0-9]{0,30}$"
  },
  "num": {
   "oneOf": [
    {
     "type": "number"
    },
    {
     "type": "string",
     "description": "Expression: + - * / % ^, comparisons, && || !, cond ? a : b, functions (sin cos tan sqrt abs exp ln log min max floor ceil clamp lerp hypot mod…), constants pi e, the control ids, t, vars, state and the scene functions."
    },
    {
     "type": "boolean"
    }
   ]
  },
  "point": {
   "type": "array",
   "items": {
    "$ref": "#/$defs/num"
   },
   "minItems": 2,
   "maxItems": 2
  },
  "color": {
   "type": "string",
   "description": "CSS color: #hex, rgb(), hsl() or a name."
  },
  "control": {
   "oneOf": [
    {
     "type": "object",
     "properties": {
      "kind": {
       "const": "slider"
      },
      "id": {
       "$ref": "#/$defs/id"
      },
      "label": {
       "type": "string"
      },
      "hint": {
       "type": "string"
      },
      "min": {
       "type": "number"
      },
      "max": {
       "type": "number"
      },
      "value": {
       "type": "number"
      },
      "step": {
       "type": "number"
      },
      "unit": {
       "type": "string"
      }
     },
     "required": [
      "kind",
      "id"
     ]
    },
    {
     "type": "object",
     "properties": {
      "kind": {
       "const": "toggle"
      },
      "id": {
       "$ref": "#/$defs/id"
      },
      "label": {
       "type": "string"
      },
      "value": {
       "type": "boolean"
      }
     },
     "required": [
      "kind",
      "id"
     ]
    },
    {
     "type": "object",
     "properties": {
      "kind": {
       "const": "button"
      },
      "id": {
       "$ref": "#/$defs/id"
      },
