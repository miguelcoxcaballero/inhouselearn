 "pendulum": {
  "type": "scene",
  "title": "Péndulo simple",
  "alt": "Un péndulo que oscila desde un punto fijo; los deslizadores cambian su longitud y la gravedad, y el periodo se recalcula.",
  "width": 600,
  "height": 420,
  "camera": {
   "xmin": -2.2,
   "xmax": 2.2,
   "ymin": -2.6,
   "ymax": 0.48
  },
  "controls": [
   {
    "kind": "slider",
    "id": "L",
    "label": "Longitud",
    "min": 0.3,
    "max": 2.2,
    "value": 1.2,
    "step": 0.05,
    "unit": "m"
   },
   {
    "kind": "slider",
    "id": "g",
    "label": "Gravedad",
    "min": 1.6,
    "max": 25,
    "value": 9.81,
    "step": 0.1,
    "unit": "m/s²"
   },
   {
    "kind": "button",
    "id": "r",
    "label": "Soltar de nuevo",
    "action": "reset"
   }
  ],
  "layers": [
   {
    "kind": "rect",
    "x": -0.6,
    "y": 0,
    "w": 1.2,
    "h": 0.12,
    "fill": "#94a3b8"
   },
   {
    "kind": "line",
    "from": [
     0,
     0
    ],
    "to": [
     0,
     "-L"
    ],
    "stroke": "#cbd5e1",
    "dash": "4 4"
   },
   {
    "kind": "pendulum",
    "id": "p",
    "pivot": [
     0,
     0
    ],
    "length": "L",
    "gravity": "g",
    "angle": 35,
    "damping": 0.02,
    "color": "#E07A3C",
    "radius": 16
   },
   {
    "kind": "label",
    "at": [
     1.3,
     -2.35
    ],
    "text": "θ = {p_angle:0}°",
    "size": 14
   }
  ],
  "readouts": [
   {
    "label": "Periodo \\(T = 2\\pi\\sqrt{L/g}\\)",
    "expr": "2*pi*sqrt(L/g)",
    "unit": "s",
    "digits": 2
   },
   {
    "label": "Ángulo",
    "expr": "p_angle",
    "unit": "°",
    "digits": 0
   }
  ]
 },
 "sort": {
  "type": "sandbox",
  "title": "Ordenación de burbuja, paso a paso",
  "alt": "Barras que se ordenan de menor a mayor; a la derecha, un mapa de los pasos del algoritmo con el paso actual resaltado. Toca las barras para barajarlas.",
  "height": 260,
  "html": "<div id=\"w\" style=\"display:flex;gap:14px;flex-wrap:wrap;padding:10px\">\n<canvas id=\"c\" width=\"380\" height=\"220\" style=\"flex:1 1 300px;max-width:100%\"></canvas>\n<svg id=\"m\" viewBox=\"0 0 260 220\" style=\"flex:1 1 220px;max-width:100%\"></svg></div>\n<script>\nvar c=document.getElementById('c'),x=c.getContext('2d'),m=document.getElementById('m');\nvar nodes=[['Comparar vecinos',130,26],['¿El de la izquierda es mayor?',130,78],['Intercambiar',60,134],['Avanzar',200,134],['Fin de pasada',130,190]];\nvar links=[[0,1],[1,2],[1,3],[2,3],[3,0],[3,4],[4,0]];\nvar a=[],n=12,i=0,j=0,steps=0,state=0,done=false,acc=0,last=0;\nfunction reset(){a=[];for(var k=0;k<n;k++)a.push(10+Math.round(Math.random()*90));i=0;j=0;steps=0;state=0;done=false}\nfunction map(){var s='';links.forEach(function(l){var p=nodes[l[0]],q=nodes[l[1]];s+='<line x1=\"'+p[1]+'\" y1=\"'+p[2]+'\" x2=\"'+q[1]+'\" y2=\"'+q[2]+'\" stroke=\"#d6d3d1\" stroke-width=\"2\"/>'});\nnodes.forEach(function(nd,k){var on=k===state;s+='<g><rect x=\"'+(nd[1]-62)+'\" y=\"'+(nd[2]-15)+'\" width=\"124\" height=\"30\" rx=\"15\" fill=\"'+(on?'#E07A3C':'#fff')+'\" stroke=\"'+(on?'#E07A3C':'#d6d3d1')+'\"/><text x=\"'+nd[1]+'\" y=\"'+(nd[2]+4)+'\" text-anchor=\"middle\" font-size=\"10.5\" fill=\"'+(on?'#fff':'#444')+'\">'+nd[0]+'</text></g>'});m.innerHTML=s}\nfunction draw(){x.clearRect(0,0,c.width,c.height);var bw=c.width/n;for(var k=0;k<n;k++){var h=a[k]*1.9;x.fillStyle=done||k>=n-i?'#16a34a':(k===j||k===j+1)?'#E07A3C':'#cbd5e1';x.fillRect(k*bw+3,c.height-h,bw-6,h)}\nx.fillStyle='#444';x.font='12px system-ui';x.fillText(done?'Ordenado en '+steps+' pasos':'Pasada '+(i+1)+' · paso '+steps,6,14);map()}\nfunction tick(){if(done)return;steps++;\nif(state===0){state=1}else if(state===1){state=a[j]>a[j+1]?2:3}else if(state===2){var t=a[j];a[j]=a[j+1];a[j+1]=t;state=3}\nelse if(state===3){j++;if(j>=n-1-i){state=4}else state=0}else if(state===4){i++;j=0;if(i>=n-1){done=true;inhouse.emit('sorted',{steps:steps})}else state=0}}\nfunction loop(ts){var dt=Math.min(100,ts-(last||ts));last=ts;acc+=dt;while(acc>180){acc-=180;tick()}draw();requestAnimationFrame(loop)}\nreset();draw();requestAnimationFrame(loop);c.addEventListener('click',function(){reset()});\n</script>",
  "emit": [
   "sorted"
  ]
 }
}